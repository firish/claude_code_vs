<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Deliberately does NOT reference BuildBreak.Core: the fixture wants one project failing and one
       succeeding, and it wants this app runnable under F5 even while Core is broken, so vs_read_output
       can be exercised independently of vs_build. -->

</Project>
